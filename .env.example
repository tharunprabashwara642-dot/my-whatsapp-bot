# Copy to .env and set the account owner explicitly. Use international digits without +.
KITEFRAME_NAME=Kiteframe
KITEFRAME_OWNER_NUMBERS=15551234567
KITEFRAME_SUDO_NUMBERS=
KITEFRAME_PREFIXES=/
KITEFRAME_ACCESS_MODE=public
KITEFRAME_TIMEZONE=UTC
KITEFRAME_LANGUAGE=en
KITEFRAME_DATABASE_PATH=./data/kiteframe.sqlite
KITEFRAME_AUTH_DIR=./auth
KITEFRAME_LOG_LEVEL=info

# disabled | openai-compatible | gemini | ollama
KITEFRAME_AI_PROVIDER=disabled
KITEFRAME_AI_MODEL=gpt-4o-mini
# Optional. Defaults to the selected provider's standard endpoint.
KITEFRAME_AI_ENDPOINT=
KITEFRAME_AI_API_KEY=
KITEFRAME_AI_TEMPERATURE=0.7
KITEFRAME_AI_MAX_TOKENS=700
KITEFRAME_AI_SYSTEM_PROMPT=You are a helpful, concise assistant.
# Private-chat conversation storage is opt-in and off by default.
KITEFRAME_AI_MEMORY=false

KITEFRAME_MEDIA_MAX_BYTES=8388608
KITEFRAME_MEDIA_MAX_VIDEO_SECONDS=8
KITEFRAME_FFMPEG_PATH=ffmpeg
KITEFRAME_FFPROBE_PATH=ffprobe
