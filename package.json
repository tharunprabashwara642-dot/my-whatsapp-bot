{
  "name": "kiteframe-wa",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "A modular, privacy-conscious WhatsApp automation platform.",
  "license": "MIT",
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "NODE_ENV=development bun --watch run src/index.ts",
    "lint": "bun run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "smoke": "bun run scripts/smoke.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "baileys": "7.0.0-rc13",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "prettier": "^3.9.4",
    "typescript": "^5.9.3"
  },
  "trustedDependencies": [
    "baileys",
    "esbuild",
    "protobufjs"
  ]
}
